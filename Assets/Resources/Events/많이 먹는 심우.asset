    - name: "\uC2EC\uC6B0"
      text: "\uB9C8\uC2EF\uB530\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\u314F\uC545!"
  - state: 2
    Dialogues:
    - name: "\uC2EC\uC6B0"
      text: "\uCEAC\uD558\uC544\uC544\uC544\uC544\uC545 \uC798\uBABB\uB0B4\uC654\uB2E4\uB2E4\uC544\uC544\uC544\u314F\u3131\u3131"
    - name: "\uC2EC\uC6B0"
      text: "\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531\uB531"
